        "it" : { "stringUnit" : { "state" : "translated", "value" : "Ho anche questi esercizi miei. Usa i loro nomi esatti quando sono adatti: %@." } }
      }
    },
    "prompt.reply" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reply with the link on a line by itself, then the plan as a short list. The plan I want:" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Rispondi con il link da solo su una riga, poi la scheda come breve elenco. La scheda che voglio:" } }
      }
    },
