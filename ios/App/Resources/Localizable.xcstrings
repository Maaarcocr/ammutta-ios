      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Share AI Prompt" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Condividi prompt per l'IA" } }
      }
    },
    "prompt.format %@ %@" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Create an Ammutta workout plan link for me. Format: ammutta://plan?v=1&name=<plan name>&e=<exercise>:<sets>:<rest>, with one &e= per exercise, in order. Write spaces as %%20 and never put colons inside names.\n\n<exercise> is a built-in key (reps: %1$@; timed: %2$@) or any other exercise name. Exercises that aren't built in are fine: the app creates them.\n\n<sets> is comma-separated: 8 = 8 reps without added weight, 8@60 = 8 reps with 60 of weight (decimals use a dot: 8@62.5), 45s, 2m or 1m30s = a timed set, 3x8@60 = three identical sets. One exercise uses only reps or only timed sets. <rest> is the rest between sets in seconds (0–600) and can be left out. Limits: 1–30 exercises, 1–20 sets each, 1–999 reps, timed sets from 5 seconds to 60 minutes." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Crea per me il link di una scheda di allenamento Ammutta. Formato: ammutta://plan?v=1&name=<nome della scheda>&e=<esercizio>:<serie>:<recupero>, con un &e= per esercizio, in ordine. Scrivi gli spazi come %%20 e non usare mai i due punti nei nomi.\n\n<esercizio> è una chiave predefinita (ripetizioni: %1$@; a tempo: %2$@) oppure qualsiasi altro nome di esercizio. Gli esercizi non predefiniti vanno bene: l'app li crea.\n\n<serie> è un elenco separato da virgole: 8 = 8 ripetizioni senza peso aggiunto, 8@60 = 8 ripetizioni con 60 di peso (i decimali usano il punto: 8@62.5), 45s, 2m o 1m30s = una serie a tempo, 3x8@60 = tre serie uguali. Un esercizio usa solo ripetizioni o solo serie a tempo. <recupero> è il recupero tra le serie in secondi (0–600) e si può omettere. Limiti: 1–30 esercizi, 1–20 serie ciascuno, 1–999 ripetizioni, serie a tempo da 5 secondi a 60 minuti." } }
      }
    },
    "prompt.kind.reps" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "reps" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "ripetizioni" } }
      }
    },
    "prompt.kind.timed" : {
      "localizations" : {
