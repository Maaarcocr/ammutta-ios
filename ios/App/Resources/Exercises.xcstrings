    "muscles.wall-sit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quads · Glutes" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Quadricipiti · Glutei" } } } },
    "tip.arnold-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start with your palms facing you and rotate them forward as you press overhead." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Parti con i palmi rivolti verso di te e ruotali in avanti mentre spingi sopra la testa." } } } },
    "tip.assisted-dip" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lower until your shoulders are level with your elbows, then press back up." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Scendi finché le spalle sono all'altezza dei gomiti, poi spingi di nuovo in alto." } } } },
    "tip.assisted-pull-up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "More counterweight makes it easier; pull until your chin clears the bar." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Più contrappeso rende l'esercizio più facile; tira finché il mento supera la sbarra." } } } },
    "tip.back-extension" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hinge at the hips over the pad and rise until your body is in a straight line, without overarching." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Piegati alle anche sul supporto e risali finché il corpo è in linea retta, senza inarcarti troppo." } } } },
    "tip.barbell-back-squat" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Brace your core, squat until your thighs are at least parallel, and drive up through your whole foot." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Contrai il core, scendi finché le cosce sono almeno parallele al pavimento e risali spingendo con tutto il piede." } } } },
    "tip.barbell-bench-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lower the bar to mid-chest with your elbows at about 45°, then press up with your feet planted." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Porta il bilanciere a metà petto con i gomiti a circa 45°, poi spingi con i piedi ben piantati a terra." } } } },
    "tip.barbell-curl" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your elbows at your sides and curl without swinging your back." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni i gomiti ai fianchi e fletti senza slanciare la schiena." } } } },
    "tip.barbell-deadlift" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep the bar close to your shins and your back flat, then push the floor away until you stand tall." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni il bilanciere vicino alle tibie e la schiena neutra, poi spingi il pavimento finché sei in piedi." } } } },
    "tip.barbell-front-squat" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest the bar on the front of your shoulders, keep your elbows high and your torso upright." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appoggia il bilanciere sulla parte anteriore delle spalle, tieni i gomiti alti e il busto dritto." } } } },
    "tip.barbell-hip-thrust" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest your upper back on a bench, tuck your chin and drive your hips up until your body is straight from shoulders to knees." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appoggia la parte alta della schiena alla panca, mento basso, e spingi le anche in alto finché spalle e ginocchia sono allineate." } } } },
    "tip.barbell-overhead-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Squeeze your glutes, press the bar straight up and move your head forward once the bar passes your face." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Contrai i glutei, spingi il bilanciere in verticale e porta la testa in avanti quando il bilanciere supera il viso." } } } },
    "tip.barbell-romanian-deadlift" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With soft knees, push your hips back and slide the bar down your thighs until you feel a stretch in your hamstrings." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Con le ginocchia leggermente flesse, porta indietro le anche e fai scendere il bilanciere lungo le cosce finché senti allungare i femorali." } } } },
    "tip.barbell-row" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hinge forward with a flat back and pull the bar to your lower ribs." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Inclinati in avanti con la schiena neutra e tira il bilanciere verso le costole basse." } } } },
    "tip.barbell-shrug" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lift your shoulders straight up toward your ears, pause, and lower slowly." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Solleva le spalle in verticale verso le orecchie, fermati un attimo e scendi lentamente." } } } },
    "tip.battle-ropes" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stand in a half squat and make fast, alternating waves from your shoulders." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "In mezzo squat, crea onde rapide e alternate partendo dalle spalle." } } } },
    "tip.bear-crawl" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Crawl on hands and feet with your knees just off the floor and your back flat." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Avanza su mani e piedi con le ginocchia appena sollevate e la schiena piatta." } } } },
    "tip.bear-plank" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On hands and toes, lift your knees just off the floor and keep your back flat." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "In appoggio su mani e punte dei piedi, solleva le ginocchia di pochi centimetri e tieni la schiena piatta." } } } },
    "tip.bodyweight-squat" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your chest up and heels down, and squat as deep as you comfortably can." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Petto alto e talloni a terra, scendi quanto più in basso riesci in modo confortevole." } } } },
    "tip.bulgarian-split-squat" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest your back foot on a bench and lower straight down on your front leg." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appoggia il piede dietro su una panca e scendi in verticale sulla gamba davanti." } } } },
    "tip.burpee" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Squat down, jump your feet back to a plank, jump them back in and leap up." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Accosciati, porta i piedi indietro in plank, riportali avanti e salta verso l'alto." } } } },
    "tip.cable-curl" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your elbows still at your sides and curl the handle up toward your shoulders." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni i gomiti fermi ai fianchi e porta la maniglia verso le spalle." } } } },
    "tip.cable-face-pull" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pull the rope toward your face, separating the ends and keeping your elbows high." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tira la corda verso il viso, separando le estremità e tenendo i gomiti alti." } } } },
    "tip.cable-overhead-triceps-extension" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Face away from the cable and straighten your arms overhead, keeping your elbows close to your head." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Dai le spalle al cavo e distendi le braccia sopra la testa, tenendo i gomiti vicini alla testa." } } } },
    "tip.cable-woodchop" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rotate through your torso to pull the handle diagonally across your body, keeping your arms long." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Ruota il busto per tirare la maniglia in diagonale davanti al corpo, tenendo le braccia distese." } } } },
    "tip.chin-up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use an underhand grip, pull your chest toward the bar and lower all the way down." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Usa una presa supina, porta il petto verso la sbarra e scendi fino in fondo." } } } },
    "tip.close-grip-bench-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Grip the bar about shoulder-width apart and keep your elbows close to your body." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impugna il bilanciere alla larghezza delle spalle e tieni i gomiti vicini al corpo." } } } },
    "tip.crunch" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Curl your shoulders off the floor by squeezing your abs, without pulling on your neck." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Solleva le spalle da terra contraendo gli addominali, senza tirare il collo." } } } },
    "tip.dead-hang" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hang from the bar with straight arms and a strong grip." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Resta appeso alla sbarra a braccia tese, stringendo forte la presa." } } } },
    "tip.dip" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lean slightly forward, lower until your shoulders are level with your elbows, then press up." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Inclinati leggermente in avanti, scendi finché le spalle sono all'altezza dei gomiti, poi spingi." } } } },
    "tip.dumbbell-bench-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lower the dumbbells to the sides of your chest, then press them up and slightly together." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Porta i manubri ai lati del petto, poi spingili in alto avvicinandoli leggermente." } } } },
    "tip.dumbbell-curl" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your elbows at your sides and turn your palms up as you curl." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni i gomiti ai fianchi e ruota i palmi verso l'alto mentre fletti." } } } },
    "tip.dumbbell-fly" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep a slight bend in your elbows and open your arms until you feel a stretch across your chest." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni i gomiti leggermente flessi e apri le braccia finché senti allungare il petto." } } } },
    "tip.dumbbell-lateral-raise" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Raise the dumbbells out to the sides up to shoulder height, leading with your elbows." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Solleva i manubri lateralmente fino all'altezza delle spalle, guidando il movimento con i gomiti." } } } },
    "tip.dumbbell-lunge" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Step forward and lower until both knees are bent at about 90°, then push back up." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Fai un passo avanti e scendi finché entrambe le ginocchia sono piegate a circa 90°, poi risali." } } } },
    "tip.dumbbell-romanian-deadlift" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Push your hips back and lower the dumbbells along your legs, keeping your back flat." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Porta indietro le anche e fai scendere i manubri lungo le gambe, tenendo la schiena neutra." } } } },
    "tip.dumbbell-row" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Support yourself on a bench and pull the dumbbell toward your hip, keeping your back flat." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appoggiati a una panca e tira il manubrio verso l'anca, tenendo la schiena neutra." } } } },
    "tip.dumbbell-shoulder-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start with the dumbbells at shoulder height and press up without arching your lower back." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Parti con i manubri all'altezza delle spalle e spingi in alto senza inarcare la zona lombare." } } } },
    "tip.dumbbell-triceps-extension" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold one dumbbell overhead with both hands, lower it behind your head and keep your elbows pointing up." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni un manubrio sopra la testa con entrambe le mani, abbassalo dietro la nuca e tieni i gomiti rivolti verso l'alto." } } } },
    "tip.glute-bridge-hold" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lying on your back, drive your hips up and hold with your glutes squeezed." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Sdraiato sulla schiena, spingi le anche in alto e mantieni contraendo i glutei." } } } },
    "tip.good-morning" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With the bar on your back and soft knees, hinge at the hips until your torso is nearly parallel to the floor." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Con il bilanciere sulla schiena e le ginocchia morbide, piegati alle anche finché il busto è quasi parallelo al pavimento." } } } },
    "tip.hack-squat" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your back against the pad and lower until your thighs are parallel to the platform." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni la schiena contro lo schienale e scendi finché le cosce sono parallele alla pedana." } } } },
    "tip.hammer-curl" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your palms facing each other the whole time and avoid swinging." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni i palmi rivolti l'uno verso l'altro per tutto il movimento ed evita di slanciarti." } } } },
    "tip.hanging-knee-raise" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hang from a bar and bring your knees toward your chest without swinging." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appeso alla sbarra, porta le ginocchia verso il petto senza oscillare." } } } },
    "tip.hanging-leg-raise" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hang from a bar and raise your straight legs to hip height or higher without swinging." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appeso alla sbarra, solleva le gambe tese almeno all'altezza delle anche senza oscillare." } } } },
    "tip.high-knees" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Run in place, bringing your knees up to hip height and pumping your arms." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Corri sul posto portando le ginocchia all'altezza delle anche e muovendo le braccia." } } } },
    "tip.hip-abductor" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Push your knees apart against the pads with control, then return slowly." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Apri le ginocchia contro i cuscinetti in modo controllato, poi torna lentamente." } } } },
    "tip.hip-adductor" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Squeeze your knees together against the pads, then let them open slowly." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Stringi le ginocchia contro i cuscinetti, poi lasciale aprire lentamente." } } } },
    "tip.hollow-hold" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Press your lower back into the floor and hold your arms and legs just off the ground." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Premi la zona lombare a terra e tieni braccia e gambe appena sollevate dal pavimento." } } } },
    "tip.incline-barbell-bench-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set the bench at 30–45° and lower the bar to your upper chest." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Inclina la panca a 30–45° e porta il bilanciere alla parte alta del petto." } } } },
    "tip.incline-dumbbell-bench-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set the bench at 30–45° and press the dumbbells up over your upper chest." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Inclina la panca a 30–45° e spingi i manubri sopra la parte alta del petto." } } } },
    "tip.inverted-row" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hang under a bar with your body straight and pull your chest up to it." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appenditi sotto una sbarra con il corpo dritto e tira il petto verso di essa." } } } },
    "tip.jump-rope" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stay on the balls of your feet and turn the rope with your wrists, not your arms." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Resta sugli avampiedi e fai girare la corda con i polsi, non con le braccia." } } } },
    "tip.kettlebell-goblet-squat" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold the weight at your chest, keep your elbows inside your knees and sit down between your heels." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni il peso al petto, i gomiti dentro le ginocchia, e scendi tra i talloni." } } } },
    "tip.kettlebell-swing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hinge instead of squatting, and snap your hips forward to float the bell to chest height." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Piegati alle anche invece di accosciarti e spingi le anche in avanti con forza per portare la kettlebell all'altezza del petto." } } } },
    "tip.l-sit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Press down through your hands, lift your hips and hold your legs straight out in front." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Spingi con le mani, solleva le anche e tieni le gambe tese davanti a te." } } } },
    "tip.lat-pulldown" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pull the bar to your upper chest, driving your elbows down and back." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tira la barra verso la parte alta del petto, portando i gomiti in basso e indietro." } } } },
    "tip.leg-curl" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Line your knees up with the pivot, pull the pad down and under, then let it return slowly." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Allinea le ginocchia con il perno, porta il rullo in basso e indietro, poi lascialo tornare lentamente." } } } },
    "tip.leg-extension" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Line your knees up with the machine's pivot, straighten your legs fully, then lower slowly." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Allinea le ginocchia con il perno della macchina, distendi completamente le gambe e scendi lentamente." } } } },
    "tip.leg-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lower the platform until your knees are near 90° without letting your lower back lift off the seat." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Abbassa la pedana finché le ginocchia sono a circa 90°, senza staccare la zona lombare dallo schienale." } } } },
    "tip.leg-raise" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lie with your lower back pressed into the floor and raise your straight legs to vertical." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Sdraiati con la zona lombare a contatto con il pavimento e solleva le gambe tese fino alla verticale." } } } },
    "tip.lying-leg-curl" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your hips pressed into the pad and curl your heels toward your glutes." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni le anche premute sul supporto e porta i talloni verso i glutei." } } } },
    "tip.machine-chest-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set the handles at mid-chest height and press forward without locking your elbows hard." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Regola le maniglie all'altezza di metà petto e spingi in avanti senza bloccare i gomiti." } } } },
    "tip.machine-shoulder-press" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start with the handles at shoulder height and press up without arching your back." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Parti con le maniglie all'altezza delle spalle e spingi in alto senza inarcare la schiena." } } } },
    "tip.mountain-climbers" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "From a plank, drive your knees toward your chest one at a time, keeping your hips low." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Dalla posizione di plank, porta le ginocchia al petto alternandole, tenendo le anche basse." } } } },
    "tip.pec-deck" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bring the handles together in front of your chest with a slight bend in your elbows." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Avvicina le maniglie davanti al petto con i gomiti leggermente flessi." } } } },
    "tip.plank" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold a straight line from head to heels, squeezing your glutes and bracing your abs." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Mantieni una linea retta dalla testa ai talloni, contraendo glutei e addominali." } } } },
    "tip.pull-up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start from straight arms with an overhand grip and pull until your chin clears the bar." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Parti a braccia tese con presa prona e tira finché il mento supera la sbarra." } } } },
    "tip.push-up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your body in a straight line and lower until your chest is just above the floor." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni il corpo in linea retta e scendi finché il petto è appena sopra il pavimento." } } } },
    "tip.rear-delt-fly" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hinge forward with a flat back and raise the dumbbells out to the sides, squeezing your shoulder blades." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Inclinati in avanti con la schiena neutra e solleva i manubri lateralmente stringendo le scapole." } } } },
    "tip.seated-cable-row" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sit tall and pull the handle to your stomach, squeezing your shoulder blades together." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Siediti dritto e tira la maniglia verso l'addome, stringendo le scapole." } } } },
    "tip.seated-calf-raise" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause briefly in the bottom stretch and at the top of each rep." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Fermati un attimo in basso in allungamento e in alto a ogni ripetizione." } } } },
    "tip.side-plank" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stack your feet, keep your elbow under your shoulder and don't let your hips sag." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Piedi sovrapposti, gomito sotto la spalla, e non lasciare cadere le anche." } } } },
    "tip.sit-up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Anchor your feet, roll up one vertebra at a time and lower with control." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Blocca i piedi, sali una vertebra alla volta e scendi in modo controllato." } } } },
    "tip.smith-machine-squat" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Place your feet slightly in front of the bar and squat with your chest up." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Metti i piedi leggermente avanti rispetto al bilanciere e scendi tenendo il petto alto." } } } },
    "tip.standing-calf-raise" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lower your heels for a full stretch, then rise as high as you can onto your toes." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Abbassa i talloni per un allungamento completo, poi sali il più in alto possibile sulle punte." } } } },
    "tip.step-up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Put your whole foot on the box and drive up through that leg without pushing off the back foot." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Appoggia tutto il piede sul rialzo e sali spingendo con quella gamba, senza darti la spinta con il piede dietro." } } } },
    "tip.sumo-deadlift" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a wide stance with your toes out, grip inside your knees and push your knees out as you lift." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Piedi larghi e punte in fuori, impugna dentro le ginocchia e spingile in fuori mentre sollevi." } } } },
    "tip.superman-hold" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lying face down, lift your arms, chest and legs off the floor and hold." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "A pancia in giù, solleva braccia, petto e gambe dal pavimento e mantieni." } } } },
    "tip.triceps-pushdown" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep your elbows pinned to your sides and push down until your arms are straight." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tieni i gomiti fermi ai fianchi e spingi verso il basso fino a distendere le braccia." } } } },
    "tip.walking-lunge" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Step forward into each lunge, keeping your torso upright and your front knee over your foot." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Avanza a ogni affondo tenendo il busto dritto e il ginocchio davanti sopra il piede." } } } },
    "tip.wall-sit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Slide down the wall until your thighs are parallel to the floor and keep your back flat against it." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Scivola lungo il muro finché le cosce sono parallele al pavimento e tieni la schiena aderente." } } } }
  },
  "version" : "1.0"
}
