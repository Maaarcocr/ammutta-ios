{
  // Deployed by .github/workflows/server.yml, which fills in the KV namespace ID.
  "name": "ammutta-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "OAUTH_KV_ID" }],
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "Account" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  "observability": { "enabled": true }
}
